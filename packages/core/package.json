    "./popper":            { "import": "./dist/esm/components/popper/index.js",            "types": "./dist/types/components/popper/index.d.ts" },
    "./portal":            { "import": "./dist/esm/components/portal/index.js",            "types": "./dist/types/components/portal/index.d.ts" },
    "./progress":          { "import": "./dist/esm/components/progress/index.js",          "types": "./dist/types/components/progress/index.d.ts" },
    "./radio":             { "import": "./dist/esm/components/radio/index.js",             "types": "./dist/types/components/radio/index.d.ts" },
    "./rating":            { "import": "./dist/esm/components/rating/index.js",            "types": "./dist/types/components/rating/index.d.ts" },
    "./select":            { "import": "./dist/esm/components/select/index.js",            "types": "./dist/types/components/select/index.d.ts" },
    "./skeleton":          { "import": "./dist/esm/components/skeleton/index.js",          "types": "./dist/types/components/skeleton/index.d.ts" },
    "./slider":            { "import": "./dist/esm/components/slider/index.js",            "types": "./dist/types/components/slider/index.d.ts" },
    "./snackbar":          { "import": "./dist/esm/components/snackbar/index.js",          "types": "./dist/types/components/snackbar/index.d.ts" },
    "./speed-dial":        { "import": "./dist/esm/components/speed-dial/index.js",        "types": "./dist/types/components/speed-dial/index.d.ts" },
    "./stack":             { "import": "./dist/esm/components/stack/index.js",             "types": "./dist/types/components/stack/index.d.ts" },
    "./stepper":           { "import": "./dist/esm/components/stepper/index.js",           "types": "./dist/types/components/stepper/index.d.ts" },
    "./switch":            { "import": "./dist/esm/components/switch/index.js",            "types": "./dist/types/components/switch/index.d.ts" },
    "./table":             { "import": "./dist/esm/components/table/index.js",             "types": "./dist/types/components/table/index.d.ts" },
    "./tabs":              { "import": "./dist/esm/components/tabs/index.js",              "types": "./dist/types/components/tabs/index.d.ts" },
    "./text-field":        { "import": "./dist/esm/components/text-field/index.js",        "types": "./dist/types/components/text-field/index.d.ts" },
    "./toolbar":           { "import": "./dist/esm/components/toolbar/index.js",           "types": "./dist/types/components/toolbar/index.d.ts" },
    "./tooltip":           { "import": "./dist/esm/components/tooltip/index.js",           "types": "./dist/types/components/tooltip/index.d.ts" },
    "./transitions":       { "import": "./dist/esm/components/transitions/index.js",       "types": "./dist/types/components/transitions/index.d.ts" },
    "./typography":        { "import": "./dist/esm/components/typography/index.js",        "types": "./dist/types/components/typography/index.d.ts" }
  },
  "files": ["dist/"],
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx ../../scripts/build.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "material-design",
    "web-components",
    "custom-elements",
    "ui-components",
    "vanilla-js",
    "framework-agnostic"
  ]
}
