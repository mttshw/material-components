{
  "name": "@materialelements/core",
  "version": "0.1.0",
  "description": "Material Design web components — zero runtime dependencies, framework-agnostic",
  "license": "MIT",
  "homepage": "https://materialelements.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mttshw/material-components.git"
  },
  "bugs": {
    "url": "https://github.com/mttshw/material-components/issues"
  },
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/types/index.d.ts"
    },

    "./accordion":         { "import": "./dist/esm/components/accordion/index.js",         "types": "./dist/types/components/accordion/index.d.ts" },
    "./alert":             { "import": "./dist/esm/components/alert/index.js",             "types": "./dist/types/components/alert/index.d.ts" },
    "./app-bar":           { "import": "./dist/esm/components/app-bar/index.js",           "types": "./dist/types/components/app-bar/index.d.ts" },
    "./autocomplete":      { "import": "./dist/esm/components/autocomplete/index.js",      "types": "./dist/types/components/autocomplete/index.d.ts" },
    "./avatar":            { "import": "./dist/esm/components/avatar/index.js",            "types": "./dist/types/components/avatar/index.d.ts" },
    "./backdrop":          { "import": "./dist/esm/components/backdrop/index.js",          "types": "./dist/types/components/backdrop/index.d.ts" },
