{% extends "_layout.njk" %}
{% set pageTitle = "materialcomponents.io — Material UI Web Components" %}

{% block content %}
<mc-typography variant="h4" gutter-bottom>materialcomponents.io</mc-typography>
<mc-typography variant="subtitle1" color="textSecondary">
  Zero-dependency Material UI Web Components. Visually identical to MUI.
  Accepts standard MUI theme objects. No React required.
</mc-typography>

<h2>Buttons</h2>
<section class="demo-section">
  <mc-button variant="contained">Contained</mc-button>
  <mc-button variant="outlined">Outlined</mc-button>
  <mc-button>Text</mc-button>
  <mc-button variant="contained" color="secondary">Secondary</mc-button>
  <mc-button variant="contained" disabled>Disabled</mc-button>
</section>

<h2>Typography</h2>
<section class="demo-section" style="flex-direction:column;align-items:flex-start;gap:4px">
  <mc-typography variant="h5">Heading 5</mc-typography>
  <mc-typography variant="body1">Body 1 — the standard paragraph style.</mc-typography>
  <mc-typography variant="body2" color="textSecondary">Body 2 — secondary text style.</mc-typography>
  <mc-typography variant="caption">Caption text</mc-typography>
</section>

<h2>Paper &amp; Elevation</h2>
<section class="demo-section">
  <mc-paper elevation="0" style="padding:16px;width:80px;text-align:center">0</mc-paper>
  <mc-paper elevation="1" style="padding:16px;width:80px;text-align:center">1</mc-paper>
  <mc-paper elevation="4" style="padding:16px;width:80px;text-align:center">4</mc-paper>
  <mc-paper elevation="8" style="padding:16px;width:80px;text-align:center">8</mc-paper>
  <mc-paper elevation="16" style="padding:16px;width:80px;text-align:center">16</mc-paper>
  <mc-paper variant="outlined" style="padding:16px;width:80px;text-align:center">outlined</mc-paper>
</section>

<h2>Stack &amp; Divider</h2>
<section class="demo-section" style="flex-direction:column;align-items:stretch">
  <mc-stack direction="row" spacing="2">
    <mc-button variant="outlined" size="small">One</mc-button>
    <mc-button variant="outlined" size="small">Two</mc-button>
    <mc-button variant="outlined" size="small">Three</mc-button>
  </mc-stack>
  <mc-divider style="margin:16px 0"></mc-divider>
  <mc-stack direction="row" spacing="2">
    <mc-button variant="contained" size="small">A</mc-button>
    <mc-button variant="contained" color="secondary" size="small">B</mc-button>
    <mc-button variant="contained" color="success" size="small">C</mc-button>
  </mc-stack>
</section>

<h2>Grid</h2>
<section class="demo-section" style="display:block;padding:0">
  <mc-grid container spacing="2" style="padding:16px">
    <mc-grid item xs="12" sm="6" md="4">
      <mc-paper elevation="2" style="padding:16px;text-align:center">xs=12 sm=6 md=4</mc-paper>
    </mc-grid>
    <mc-grid item xs="12" sm="6" md="4">
      <mc-paper elevation="2" style="padding:16px;text-align:center">xs=12 sm=6 md=4</mc-paper>
    </mc-grid>
    <mc-grid item xs="12" sm="12" md="4">
      <mc-paper elevation="2" style="padding:16px;text-align:center">xs=12 sm=12 md=4</mc-paper>
    </mc-grid>
  </mc-grid>
</section>

<h2>Form Controls</h2>
<section class="demo-section" style="flex-direction:column;align-items:flex-start;gap:16px">
  <mc-stack direction="row" spacing="2" style="align-items:center">
    <mc-checkbox checked></mc-checkbox>
    <mc-typography variant="body1">Checkbox</mc-typography>
    <mc-switch checked></mc-switch>
    <mc-typography variant="body1">Switch</mc-typography>
    <mc-radio checked></mc-radio>
    <mc-typography variant="body1">Radio</mc-typography>
  </mc-stack>
  <mc-text-field variant="outlined" label="Text Field"></mc-text-field>
  <mc-select variant="outlined" label="Select" style="min-width:160px">
    <option value="1">Option 1</option>
    <option value="2">Option 2</option>
    <option value="3">Option 3</option>
  </mc-select>
</section>

<h2>Quick Start</h2>
<code-sample>
&lt;script src="https://unpkg.com/@materialcomponents/core/dist/materialcomponents.min.js"&gt;&lt;/script&gt;

&lt;mc-theme-provider&gt;
  &lt;mc-css-baseline&gt;&lt;/mc-css-baseline&gt;
  &lt;mc-button variant="contained"&gt;Hello World&lt;/mc-button&gt;
&lt;/mc-theme-provider&gt;
</code-sample>
{% endblock %}
