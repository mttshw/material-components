{% extends "_layout.njk" %}
{% set pageTitle = "Menu — materialelements.io" %}
{% block content %}
<h1>Menu</h1>
<p class="me-subtitle">Menus display a list of choices on a temporary surface. They appear when users interact with a button, action, or other control.</p>

<h2>Basic</h2>
<section class="demo-section">
  <me-button variant="contained" id="basic-menu-btn">Open Menu</me-button>
  <me-menu id="basic-menu">
    <me-menu-item>Profile</me-menu-item>
    <me-menu-item>My account</me-menu-item>
    <me-menu-item>Logout</me-menu-item>
  </me-menu>
</section>
<code-sample>
&lt;me-button id="menu-btn"&gt;Open Menu&lt;/me-button&gt;
&lt;me-menu id="my-menu"&gt;
  &lt;me-menu-item&gt;Profile&lt;/me-menu-item&gt;
  &lt;me-menu-item&gt;My account&lt;/me-menu-item&gt;
  &lt;me-menu-item&gt;Logout&lt;/me-menu-item&gt;
&lt;/me-menu&gt;

&lt;script&gt;
  const menu = document.getElementById('my-menu');
  const btn  = document.getElementById('menu-btn');
  menu.anchorEl = btn;
  btn.addEventListener('click', () =&gt; menu.open = true);
  menu.addEventListener('me-close', () =&gt; menu.open = false);
&lt;/script&gt;
</code-sample>

<h2>With Selected Item</h2>
<section class="demo-section">
  <me-button variant="outlined" id="selected-menu-btn">Options</me-button>
  <me-menu id="selected-menu">
    <me-menu-item selected>None</me-menu-item>
    <me-menu-item>Ascending</me-menu-item>
    <me-menu-item>Descending</me-menu-item>
  </me-menu>
</section>

<h2>With Disabled Item</h2>
<section class="demo-section">
  <me-button variant="outlined" id="disabled-menu-btn">Actions</me-button>
  <me-menu id="disabled-menu">
    <me-menu-item>Edit</me-menu-item>
    <me-menu-item disabled>Delete (disabled)</me-menu-item>
    <me-menu-item>Duplicate</me-menu-item>
  </me-menu>
</section>

<h2>API — Menu</h2>
<table class="api-table">
  <thead><tr><th>Attribute / Property</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>open</code></td><td>boolean</td><td>false</td><td>Whether the menu is visible.</td></tr>
    <tr><td><code>anchorEl</code> (property)</td><td>HTMLElement</td><td>—</td><td>Element to anchor menu position below.</td></tr>
  </tbody>
</table>

<h2>API — MenuItem</h2>
<table class="api-table">
  <thead><tr><th>Attribute</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>selected</code></td><td>boolean</td><td>false</td><td>Highlights the item as currently selected.</td></tr>
    <tr><td><code>disabled</code></td><td>boolean</td><td>false</td><td>Disables the item.</td></tr>
    <tr><td><code>value</code></td><td>string</td><td>—</td><td>Value included in the <code>me-menu-item-click</code> event detail.</td></tr>
  </tbody>
</table>

<h2>Events</h2>
<table class="api-table">
  <thead><tr><th>Event</th><th>Detail</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>me-close</code></td><td><code>{ reason }</code></td><td>Fired on Menu when backdrop clicked or Escape pressed.</td></tr>
    <tr><td><code>me-menu-item-click</code></td><td><code>{ value }</code></td><td>Fired on MenuItem when clicked.</td></tr>
  </tbody>
</table>
{% endblock %}
{% block scripts %}
<script>
  [
    ['basic-menu-btn', 'basic-menu'],
    ['selected-menu-btn', 'selected-menu'],
    ['disabled-menu-btn', 'disabled-menu'],
  ].forEach(([btnId, menuId]) => {
    const btn  = document.getElementById(btnId);
    const menu = document.getElementById(menuId);
    if (!btn || !menu) return;
    menu.anchorEl = btn;
    btn.addEventListener('click', () => { menu.open = true; });
    menu.addEventListener('me-close', () => { menu.open = false; });
  });
</script>
{% endblock %}
