{% extends "_layout.njk" %}
{% set pageTitle = "Switch — materialcomponents.io" %}

{% block content %}
<h1>Switch</h1>
<p>Switches toggle the state of a single setting on or off.</p>

<h2>Basic</h2>
<section class="demo-section">
  <mc-switch></mc-switch>
  <mc-switch checked></mc-switch>
</section>
<code-sample>
&lt;mc-switch&gt;&lt;/mc-switch&gt;
&lt;mc-switch checked&gt;&lt;/mc-switch&gt;
</code-sample>

<h2>Colors</h2>
<section class="demo-section">
  <mc-switch checked color="primary"></mc-switch>
  <mc-switch checked color="secondary"></mc-switch>
  <mc-switch checked color="error"></mc-switch>
  <mc-switch checked color="warning"></mc-switch>
  <mc-switch checked color="info"></mc-switch>
  <mc-switch checked color="success"></mc-switch>
</section>

<h2>Disabled</h2>
<section class="demo-section">
  <mc-switch disabled></mc-switch>
  <mc-switch checked disabled></mc-switch>
</section>

<h2>With Label</h2>
<section class="demo-section" style="flex-direction:column;align-items:flex-start;gap:8px">
  <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
    <mc-typography variant="body1">Airplane mode</mc-typography>
    <mc-switch id="sw1"></mc-switch>
  </label>
  <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
    <mc-typography variant="body1">Notifications</mc-typography>
    <mc-switch id="sw2" checked></mc-switch>
  </label>
</section>
<code-sample>
&lt;label style="display:flex;align-items:center;gap:8px"&gt;
  Airplane mode
  &lt;mc-switch&gt;&lt;/mc-switch&gt;
&lt;/label&gt;
</code-sample>

<h2>API</h2>
<table class="api-table">
  <thead><tr><th>Attribute</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>checked</code></td><td>boolean</td><td>false</td><td>Whether the switch is on.</td></tr>
    <tr><td><code>disabled</code></td><td>boolean</td><td>false</td><td>Disables the switch.</td></tr>
    <tr><td><code>color</code></td><td>primary | secondary | error | warning | info | success</td><td>primary</td><td>The color palette to use.</td></tr>
    <tr><td><code>value</code></td><td>string</td><td>on</td><td>The value submitted with the form.</td></tr>
    <tr><td><code>name</code></td><td>string</td><td>—</td><td>Form field name.</td></tr>
  </tbody>
</table>

<h2>Events</h2>
<table class="api-table">
  <thead><tr><th>Event</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>change</code></td><td>Fired when the switch state changes.</td></tr>
  </tbody>
</table>
{% endblock %}
