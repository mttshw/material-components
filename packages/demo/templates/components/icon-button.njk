{% extends "_layout.njk" %}
{% set pageTitle = "Icon Button — materialelements.io" %}
{% block content %}
<h1>Icon Button</h1>
<p class="me-subtitle">Icon buttons allow users to take actions and make choices with a single tap. Ideal for toolbars and compact UIs.</p>

<h2>Basic</h2>
<section class="demo-section">
  <me-icon-button aria-label="delete">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6zM19 4h-3.5l-1-1h-5l-1 1H5v2h14z"/></svg>
  </me-icon-button>
  <me-icon-button aria-label="favorite">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="m12 21.35-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54z"/></svg>
  </me-icon-button>
  <me-icon-button aria-label="share">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92"/></svg>
  </me-icon-button>
</section>
<code-sample>
&lt;me-icon-button aria-label="delete"&gt;
  &lt;svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"&gt;...&lt;/svg&gt;
&lt;/me-icon-button&gt;
</code-sample>

<h2>Colors</h2>
<section class="demo-section">
  <me-icon-button aria-label="default">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z"/></svg>
  </me-icon-button>
  <me-icon-button color="primary" aria-label="primary">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z"/></svg>
  </me-icon-button>
  <me-icon-button color="secondary" aria-label="secondary">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z"/></svg>
  </me-icon-button>
  <me-icon-button color="error" aria-label="error">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z"/></svg>
  </me-icon-button>
  <me-icon-button color="warning" aria-label="warning">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z"/></svg>
  </me-icon-button>
  <me-icon-button color="success" aria-label="success">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z"/></svg>
  </me-icon-button>
</section>
<code-sample>
&lt;me-icon-button aria-label="..."&gt;...&lt;/me-icon-button&gt;
&lt;me-icon-button color="primary" aria-label="..."&gt;...&lt;/me-icon-button&gt;
&lt;me-icon-button color="secondary" aria-label="..."&gt;...&lt;/me-icon-button&gt;
&lt;me-icon-button color="error" aria-label="..."&gt;...&lt;/me-icon-button&gt;
</code-sample>

<h2>Sizes</h2>
<section class="demo-section" style="align-items:center">
  <me-icon-button size="small" aria-label="small">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="m12 21.35-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54z"/></svg>
  </me-icon-button>
  <me-icon-button aria-label="medium">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="m12 21.35-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54z"/></svg>
  </me-icon-button>
  <me-icon-button size="large" aria-label="large">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="m12 21.35-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54z"/></svg>
  </me-icon-button>
</section>
<code-sample>
&lt;me-icon-button size="small" aria-label="..."&gt;...&lt;/me-icon-button&gt;
&lt;me-icon-button aria-label="..."&gt;...&lt;/me-icon-button&gt;
&lt;me-icon-button size="large" aria-label="..."&gt;...&lt;/me-icon-button&gt;
</code-sample>

<h2>Disabled</h2>
<section class="demo-section">
  <me-icon-button disabled aria-label="disabled">
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6zM19 4h-3.5l-1-1h-5l-1 1H5v2h14z"/></svg>
  </me-icon-button>
</section>
<code-sample>
&lt;me-icon-button disabled aria-label="..."&gt;...&lt;/me-icon-button&gt;
</code-sample>

<h2>API</h2>
<table class="api-table">
  <thead><tr><th>Attribute</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>color</code></td><td>default | primary | secondary | error | warning | info | success | inherit</td><td>default</td><td>Button color.</td></tr>
    <tr><td><code>size</code></td><td>small | medium | large</td><td>medium</td><td>Button size (padding and font-size).</td></tr>
    <tr><td><code>disabled</code></td><td>boolean</td><td>false</td><td>Disables interaction.</td></tr>
    <tr><td><code>edge</code></td><td>start | end</td><td>—</td><td>Negative margin for use in toolbars.</td></tr>
    <tr><td><code>aria-label</code></td><td>string</td><td>—</td><td>Required accessible label.</td></tr>
  </tbody>
</table>
{% endblock %}
