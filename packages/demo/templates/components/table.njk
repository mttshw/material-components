{% extends "_layout.njk" %}
{% set pageTitle = "Table — materialcomponents.io" %}

{% block content %}
<h1>Table</h1>
<p>Tables display sets of data. They can be fully customized.</p>

<h2>Basic Table</h2>
<section class="demo-section" style="display:block;overflow-x:auto">
  <mc-paper elevation="1" style="min-width:500px">
    <mc-table>
      <mc-table-head>
        <mc-table-row>
          <mc-table-cell variant="head">Dessert</mc-table-cell>
          <mc-table-cell variant="head" align="right">Calories</mc-table-cell>
          <mc-table-cell variant="head" align="right">Fat (g)</mc-table-cell>
          <mc-table-cell variant="head" align="right">Carbs (g)</mc-table-cell>
          <mc-table-cell variant="head" align="right">Protein (g)</mc-table-cell>
        </mc-table-row>
      </mc-table-head>
      <mc-table-body>
        <mc-table-row hover>
          <mc-table-cell>Frozen yoghurt</mc-table-cell>
          <mc-table-cell align="right">159</mc-table-cell>
          <mc-table-cell align="right">6</mc-table-cell>
          <mc-table-cell align="right">24</mc-table-cell>
          <mc-table-cell align="right">4</mc-table-cell>
        </mc-table-row>
        <mc-table-row hover>
          <mc-table-cell>Ice cream sandwich</mc-table-cell>
          <mc-table-cell align="right">237</mc-table-cell>
          <mc-table-cell align="right">9</mc-table-cell>
          <mc-table-cell align="right">37</mc-table-cell>
          <mc-table-cell align="right">4.3</mc-table-cell>
        </mc-table-row>
        <mc-table-row hover selected>
          <mc-table-cell>Eclair</mc-table-cell>
          <mc-table-cell align="right">262</mc-table-cell>
          <mc-table-cell align="right">16</mc-table-cell>
          <mc-table-cell align="right">24</mc-table-cell>
          <mc-table-cell align="right">6</mc-table-cell>
        </mc-table-row>
        <mc-table-row hover>
          <mc-table-cell>Cupcake</mc-table-cell>
          <mc-table-cell align="right">305</mc-table-cell>
          <mc-table-cell align="right">3.7</mc-table-cell>
          <mc-table-cell align="right">67</mc-table-cell>
          <mc-table-cell align="right">4.3</mc-table-cell>
        </mc-table-row>
      </mc-table-body>
    </mc-table>
  </mc-paper>
</section>
<code-sample>
&lt;mc-table&gt;
  &lt;mc-table-head&gt;
    &lt;mc-table-row&gt;
      &lt;mc-table-cell variant="head"&gt;Name&lt;/mc-table-cell&gt;
      &lt;mc-table-cell variant="head" align="right"&gt;Value&lt;/mc-table-cell&gt;
    &lt;/mc-table-row&gt;
  &lt;/mc-table-head&gt;
  &lt;mc-table-body&gt;
    &lt;mc-table-row hover&gt;
      &lt;mc-table-cell&gt;Row 1&lt;/mc-table-cell&gt;
      &lt;mc-table-cell align="right"&gt;42&lt;/mc-table-cell&gt;
    &lt;/mc-table-row&gt;
  &lt;/mc-table-body&gt;
&lt;/mc-table&gt;
</code-sample>

<h2>Dense Table</h2>
<section class="demo-section" style="display:block;overflow-x:auto">
  <mc-paper elevation="1" style="min-width:400px">
    <mc-table size="small">
      <mc-table-head>
        <mc-table-row>
          <mc-table-cell variant="head">Name</mc-table-cell>
          <mc-table-cell variant="head" align="right">Calories</mc-table-cell>
          <mc-table-cell variant="head" align="right">Fat</mc-table-cell>
        </mc-table-row>
      </mc-table-head>
      <mc-table-body>
        <mc-table-row hover><mc-table-cell>Frozen yoghurt</mc-table-cell><mc-table-cell align="right">159</mc-table-cell><mc-table-cell align="right">6g</mc-table-cell></mc-table-row>
        <mc-table-row hover><mc-table-cell>Ice cream</mc-table-cell><mc-table-cell align="right">237</mc-table-cell><mc-table-cell align="right">9g</mc-table-cell></mc-table-row>
        <mc-table-row hover><mc-table-cell>Eclair</mc-table-cell><mc-table-cell align="right">262</mc-table-cell><mc-table-cell align="right">16g</mc-table-cell></mc-table-row>
      </mc-table-body>
    </mc-table>
  </mc-paper>
</section>

<h2>API — mc-table</h2>
<table class="api-table">
  <thead><tr><th>Attribute</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>size</code></td><td>medium | small</td><td>medium</td><td>Reduces cell padding.</td></tr>
    <tr><td><code>stickyHeader</code></td><td>boolean</td><td>false</td><td>Makes the header sticky.</td></tr>
  </tbody>
</table>

<h2>API — mc-table-row</h2>
<table class="api-table">
  <thead><tr><th>Attribute</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>hover</code></td><td>boolean</td><td>false</td><td>Highlights row on hover.</td></tr>
    <tr><td><code>selected</code></td><td>boolean</td><td>false</td><td>Shows selected state.</td></tr>
  </tbody>
</table>

<h2>API — mc-table-cell</h2>
<table class="api-table">
  <thead><tr><th>Attribute</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>variant</code></td><td>body | head | footer</td><td>body</td><td>Cell type.</td></tr>
    <tr><td><code>align</code></td><td>left | center | right | justify</td><td>left</td><td>Text alignment.</td></tr>
    <tr><td><code>padding</code></td><td>normal | checkbox | none</td><td>normal</td><td>Cell padding.</td></tr>
  </tbody>
</table>
{% endblock %}
