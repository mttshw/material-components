{% extends "_layout.njk" %}
{% set pageTitle = "Avatar — materialcomponents.io" %}

{% block content %}
<h1>Avatar</h1>
<p>Avatars represent a user or entity with an image, icon, or initials.</p>

<h2>Image Avatar</h2>
<section class="demo-section">
  <mc-avatar src="https://i.pravatar.cc/40?img=1" alt="User 1"></mc-avatar>
  <mc-avatar src="https://i.pravatar.cc/40?img=2" alt="User 2"></mc-avatar>
  <mc-avatar src="https://i.pravatar.cc/40?img=3" alt="User 3"></mc-avatar>
</section>
<code-sample>
&lt;mc-avatar src="photo.jpg" alt="User"&gt;&lt;/mc-avatar&gt;
</code-sample>

<h2>Letter Avatars</h2>
<section class="demo-section">
  <mc-avatar style="background-color:#1976d2">H</mc-avatar>
  <mc-avatar style="background-color:#9c27b0">W</mc-avatar>
  <mc-avatar style="background-color:#2e7d32">JK</mc-avatar>
</section>
<code-sample>
&lt;mc-avatar style="background-color:#1976d2"&gt;H&lt;/mc-avatar&gt;
</code-sample>

<h2>Variants</h2>
<section class="demo-section">
  <mc-avatar src="https://i.pravatar.cc/40?img=4" alt="Circular (default)"></mc-avatar>
  <mc-avatar src="https://i.pravatar.cc/40?img=5" alt="Rounded" variant="rounded"></mc-avatar>
  <mc-avatar src="https://i.pravatar.cc/40?img=6" alt="Square" variant="square"></mc-avatar>
</section>
<code-sample>
&lt;mc-avatar variant="circular" ...&gt;&lt;/mc-avatar&gt;
&lt;mc-avatar variant="rounded" ...&gt;&lt;/mc-avatar&gt;
&lt;mc-avatar variant="square"  ...&gt;&lt;/mc-avatar&gt;
</code-sample>

<h2>Sizes</h2>
<section class="demo-section" style="align-items:center">
  <mc-avatar src="https://i.pravatar.cc/24?img=7" alt="Small" style="width:24px;height:24px;font-size:0.75rem"></mc-avatar>
  <mc-avatar src="https://i.pravatar.cc/40?img=7" alt="Medium"></mc-avatar>
  <mc-avatar src="https://i.pravatar.cc/56?img=7" alt="Large" style="width:56px;height:56px;font-size:1.5rem"></mc-avatar>
</section>

<h2>API</h2>
<table class="api-table">
  <thead><tr><th>Attribute</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>src</code></td><td>string</td><td>—</td><td>Image URL. If absent, slot content is shown.</td></tr>
    <tr><td><code>alt</code></td><td>string</td><td>""</td><td>Alt text for the image.</td></tr>
    <tr><td><code>variant</code></td><td>circular | rounded | square</td><td>circular</td><td>Shape variant.</td></tr>
  </tbody>
</table>
{% endblock %}
