{% extends "_layout.njk" %}
{% set pageTitle = "Avatar — materialelements.io" %}

{% block content %}
<h1>Avatar</h1>
<p>Avatars represent a user or entity with an image, icon, or initials.</p>

<h2>Image Avatar</h2>
<section class="demo-section">
  <me-avatar src="https://i.pravatar.cc/40?img=1" alt="User 1"></me-avatar>
  <me-avatar src="https://i.pravatar.cc/40?img=2" alt="User 2"></me-avatar>
  <me-avatar src="https://i.pravatar.cc/40?img=3" alt="User 3"></me-avatar>
</section>
<code-sample>
&lt;me-avatar src="photo.jpg" alt="User"&gt;&lt;/me-avatar&gt;
</code-sample>

<h2>Letter Avatars</h2>
<section class="demo-section">
  <me-avatar style="background-color:#1976d2">H</me-avatar>
  <me-avatar style="background-color:#9c27b0">W</me-avatar>
  <me-avatar style="background-color:#2e7d32">JK</me-avatar>
</section>
<code-sample>
&lt;me-avatar style="background-color:#1976d2"&gt;H&lt;/me-avatar&gt;
</code-sample>

<h2>Variants</h2>
<section class="demo-section">
  <me-avatar src="https://i.pravatar.cc/40?img=4" alt="Circular (default)"></me-avatar>
  <me-avatar src="https://i.pravatar.cc/40?img=5" alt="Rounded" variant="rounded"></me-avatar>
  <me-avatar src="https://i.pravatar.cc/40?img=6" alt="Square" variant="square"></me-avatar>
</section>
<code-sample>
&lt;me-avatar variant="circular" ...&gt;&lt;/me-avatar&gt;
&lt;me-avatar variant="rounded" ...&gt;&lt;/me-avatar&gt;
&lt;me-avatar variant="square"  ...&gt;&lt;/me-avatar&gt;
</code-sample>

<h2>Sizes</h2>
<section class="demo-section" style="align-items:center">
  <me-avatar src="https://i.pravatar.cc/24?img=7" alt="Small" style="width:24px;height:24px;font-size:0.75rem"></me-avatar>
  <me-avatar src="https://i.pravatar.cc/40?img=7" alt="Medium"></me-avatar>
  <me-avatar src="https://i.pravatar.cc/56?img=7" alt="Large" style="width:56px;height:56px;font-size:1.5rem"></me-avatar>
</section>

<h2>API</h2>
<table class="api-table">
  <thead><tr><th>Attribute</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>src</code></td><td>string</td><td>—</td><td>Image URL. If absent, slot content is shown.</td></tr>
    <tr><td><code>alt</code></td><td>string</td><td>""</td><td>Alt text for the image.</td></tr>
    <tr><td><code>variant</code></td><td>circular | rounded | square</td><td>circular</td><td>Shape variant.</td></tr>
  </tbody>
</table>
{% endblock %}
