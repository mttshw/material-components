{% extends "_layout.njk" %}
{% set pageTitle = "Icon — materialelements.io" %}
{% block content %}
<h1>Icon</h1>
<p class="me-subtitle">The Icon component renders SVG icons with consistent sizing and color. Pass any SVG as its child.</p>

<h2>Basic</h2>
<section class="demo-section">
  <me-icon>
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z"/></svg>
  </me-icon>
  <me-icon>
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 21.35-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54z"/></svg>
  </me-icon>
  <me-icon>
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
  </me-icon>
</section>
<code-sample>
&lt;me-icon&gt;
  &lt;svg viewBox="0 0 24 24" fill="currentColor"&gt;...&lt;/svg&gt;
&lt;/me-icon&gt;
</code-sample>

