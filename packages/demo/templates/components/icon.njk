  <me-icon color="disabled">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z"/></svg>
  </me-icon>
</section>
<code-sample>
&lt;me-icon color="primary"&gt;...&lt;/me-icon&gt;
&lt;me-icon color="secondary"&gt;...&lt;/me-icon&gt;
&lt;me-icon color="error"&gt;...&lt;/me-icon&gt;
&lt;me-icon color="action"&gt;...&lt;/me-icon&gt;
&lt;me-icon color="disabled"&gt;...&lt;/me-icon&gt;
</code-sample>

<h2>Font Sizes</h2>
<section class="demo-section" style="align-items:center">
  <me-icon font-size="small">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
  </me-icon>
  <me-icon font-size="medium">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
  </me-icon>
  <me-icon font-size="large">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
  </me-icon>
  <me-icon font-size="inherit" style="font-size:3rem">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
  </me-icon>
</section>
<code-sample>
&lt;me-icon font-size="small"&gt;...&lt;/me-icon&gt;
&lt;me-icon font-size="medium"&gt;...&lt;/me-icon&gt;
&lt;me-icon font-size="large"&gt;...&lt;/me-icon&gt;
&lt;me-icon font-size="inherit"&gt;...&lt;/me-icon&gt;
</code-sample>

<h2>API</h2>
<table class="api-table">
  <thead><tr><th>Attribute</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>color</code></td><td>inherit | primary | secondary | action | error | warning | info | success | disabled</td><td>inherit</td><td>Icon color.</td></tr>
    <tr><td><code>font-size</code></td><td>inherit | small | medium | large</td><td>medium</td><td>Controls the icon size via <code>font-size</code>.</td></tr>
  </tbody>
</table>
{% endblock %}
